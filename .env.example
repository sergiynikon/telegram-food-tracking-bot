# From @BotFather
TELEGRAM_BOT_TOKEN=

# From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: Claude model and effort (low = cheapest/fastest, high = more careful estimates)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low

# Your Telegram user ID (the bot tells you on first message). Comma-separate several.
ALLOWED_USER_IDS=

# Used for meal time and breakfast/lunch/dinner detection
TIMEZONE=Europe/Kyiv
