[Unit]
Description=Telegram food tracking bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=foodbot
Group=foodbot
WorkingDirectory=/opt/food-bot
ExecStart=/usr/bin/node src/index.ts
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/food-bot
# /var/lib/food-bot (passed as $STATE_DIRECTORY): saved posts, so buttons and corrections survive restarts.
StateDirectory=food-bot

[Install]
WantedBy=multi-user.target
